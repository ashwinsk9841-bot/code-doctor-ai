# AI Provider Configuration
# --------------------------
# AI_PROVIDER values: "opencode_zen" (default, free), "anthropic", "openai", or "auto"
# "auto" tries OpenCode Zen first, then Anthropic, then OpenAI.

# Option A (DEFAULT, FREE): OpenCode Zen — Big Pickle model (no paid credits)
# Get a free API key at https://opencode.ai/auth
AI_PROVIDER=opencode_zen
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
OPENCODE_ZEN_MODEL=big-pickle
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Option B: Anthropic (Claude) — paid
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-sonnet-4-20250514

# Option C: OpenAI — paid
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Application Settings
MAX_FILE_SIZE_MB=10
ENABLE_SECURITY_SCAN=true
ENABLE_TEST_GENERATION=true
ENABLE_AI_ANALYSIS=true

# Repository scanning limits
MAX_REPOSITORY_MB=200
MAX_FILES=3000
GITHUB_REQUEST_TIMEOUT=30
TEST_TIMEOUT_SECONDS=180
