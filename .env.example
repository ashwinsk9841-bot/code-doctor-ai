# AI Provider Configuration
# --------------------------
# AI_PROVIDER values: "gemini" (default), "anthropic", "openai", or "auto"

# Option A (DEFAULT): Google Gemini — gemini-3.5-flash-lite (fast, stable)
# Get an API key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Option B: Anthropic (Claude) — paid
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-sonnet-4-20250514

# Option C: OpenAI — paid
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Application Settings
MAX_FILE_SIZE_MB=10
ENABLE_SECURITY_SCAN=true
ENABLE_TEST_GENERATION=true
ENABLE_AI_ANALYSIS=true

# Repository scanning limits
MAX_REPOSITORY_MB=200
MAX_FILES=3000
GITHUB_REQUEST_TIMEOUT=30
TEST_TIMEOUT_SECONDS=180
